# ============================================
# DealerOS Mobile — Environment Configuration
# ============================================

# The base URL of the DealerOS API. The mobile app reads this at
# runtime from the `expo.extra.apiBaseUrl` field in `app.json`; this
# `.env` file is the EAS build-time source that gets injected into
# the bundle. Default points at the local dev API.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Encryption key for MMKV's at-rest token store. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 16 chars. EAS injects this at build time; never
# commit the real value.
EXPO_PUBLIC_ENCRYPTION_KEY=dev-fallback-key-do-not-ship
