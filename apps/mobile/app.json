{
  "expo": {
    "name": "DealerOS",
    "slug": "dealeros-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dealeros",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0C0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dealeros.app",
      "infoPlist": {
        "NSCameraUsageDescription": "DealerOS needs camera access to scan VINs and driver's licenses for inventory and customer intake.",
        "NSPhotoLibraryUsageDescription": "DealerOS needs photo library access to attach photos to vehicles and customers.",
        "NSPhotoLibraryAddUsageDescription": "DealerOS needs to save photos taken within the app to your library."
      }
    },
    "android": {
      "package": "com.dealeros.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0C0F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DealerOS to access your camera to scan VINs and driver's licenses."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "apiBaseUrl": "http://localhost:3001",
      "encryptionKey": "dev-fallback-key-do-not-ship"
    }
  }
}
