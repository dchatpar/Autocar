# DealerOS Marketing App — environment variables

# Internal base URL for the main API. The marketing app proxies
# public reads (subdomain resolution, inventory, lead capture) to
# this server. NOT exposed to the browser; used only in route
# handlers and server components.
API_BASE_URL=http://localhost:3001

# Public base URL — only used for absolute URLs in OG tags, sitemap,
# and the embeddable inventory widget. Exposed to the client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# The domain used for the `{subdomain}.dealeros.com` resolution. Used
# by the middleware to extract the subdomain from the Host header.
# Override to a custom domain in production (e.g. dealers.dealeros.com).
NEXT_PUBLIC_MARKETING_ROOT_DOMAIN=dealeros.com

# Set to "1" to skip the subdomain check in middleware (useful for
# local dev when running on http://localhost:3000).
NEXT_PUBLIC_DISABLE_SUBDOMAIN_CHECK=

# Edge cache TTL for the inventory list (seconds). The Next.js ISR
# revalidate value is also 60s by default; this env lets ops tune it.
INVENTORY_REVALIDATE_SECONDS=60

# Sitemap / feed pagination — how many vehicles per feed batch.
SITEMAP_VEHICLES_PER_BATCH=1000
