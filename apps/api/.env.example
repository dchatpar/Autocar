# ============================================
# DealerOS API — Environment Configuration
# ============================================

# Node
NODE_ENV=development

# Database
DATABASE_URL=postgresql://dealeros:dealeros_dev_password@localhost:5432/dealeros

# Redis (for token blocklist + rate limiting)
REDIS_URL=redis://localhost:6379

# Auth
AUTH_JWT_SECRET=dev-secret-change-me
AUTH_JWT_ACCESS_EXPIRES_IN=15m
AUTH_JWT_REFRESH_EXPIRES_IN=7d

# Server
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Meta Lead Ads webhooks
META_APP_SECRET=dev-meta-secret
META_VERIFY_TOKEN=dev-verify-token
META_PAGE_ACCESS_TOKEN=dev-page-access-token

# WhatsApp Cloud API webhooks
WHATSAPP_APP_SECRET=dev-whatsapp-secret
WHATSAPP_VERIFY_TOKEN=dev-wa-verify-token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_CLOUD_API_BASE=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Meta Conversions API (CAPI) — server-side pixel events
META_CAPI_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
