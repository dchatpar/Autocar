# ============================================
# DealerOS Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# Node Environment
NODE_ENV=development

# ============================================
# Database (PostgreSQL 16 + pgvector)
# ============================================
DATABASE_URL=postgresql://dealeros:dealeros_dev_password@localhost:5432/dealeros

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Authentication (JWT)
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ============================================
# API Server
# ============================================
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60

# ============================================
# S3/MinIO (Media Storage)
# ============================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dealeros_minio
S3_SECRET_KEY=dealeros_minio_password
S3_BUCKET=dealeros-media
S3_REGION=us-east-1

# ============================================
# Hasura GraphQL Engine
# ============================================
HASURA_GRAPHQL_ADMIN_SECRET=hasura_dev_secret
HASURA_GRAPHQL_JWT_SECRET={"type":"HS256", "key": "hasura-jwt-secret-change-in-production"}

# ============================================
# Next.js Web App
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Email (for notifications)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dealeros.com

# ============================================
# AWS (Production)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# Stripe Billing
# ============================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx
APP_ORIGIN=http://localhost:3000

# ============================================
# DocuSign E-Signature
# ============================================
# JWT Grant flow (headless server-to-server auth).
# Configure the integration key + RSA private key in DocuSign
# Admin → Apps and Keys, then grant consent for the account.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE_PATH=account-d.docusign.com
DOCUSIGN_AUTH_SCOPE=signature
# The RSA private key as a single-line PEM (escape newlines as \n),
# OR provide a path to a PEM file via DOCUSIGN_PRIVATE_KEY_PATH.
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_PRIVATE_KEY_PATH=
# Connect webhook (HMAC secret configured in DocuSign Admin → Connect).
DOCUSIGN_WEBHOOK_HMAC_SECRET=
DOCUSIGN_WEBHOOK_PATH=/webhooks/docusign
# Public URL of this API — used to build the Connect callback URL.
PUBLIC_URL=http://localhost:3001
# DocuSign template GUIDs (one per document type).
DOCUSIGN_TEMPLATE_BILL_OF_SALE=
DOCUSIGN_TEMPLATE_FI_CONTRACT=
DOCUSIGN_TEMPLATE_CREDIT_APP=
DOCUSIGN_TEMPLATE_WARRANTY=
DOCUSIGN_TEMPLATE_TRADE_APPRAISAL=
