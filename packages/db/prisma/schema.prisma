// ============================================================
// DealerOS — PostgreSQL Schema (Prisma)
// Multi-tenant CRM + Inventory + Deals + AI
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & TENANTS
// ============================================================

/// Dealer — primary tenant entity. Each dealer is an isolated data partition.
model Dealer {
  id          String     @id @default(cuid())
  name        String
  subdomain   String     @unique
  plan        DealerPlan @default(STARTER)
  settings    Json       @default("{}")
  aiAgents    String[]   @default(["NOVA", "ARIO", "SAGE", "LUCAS"])
  trialEndsAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  users              User[]
  leads              Lead[]
  customers          Customer[]
  notes              Note[]
  bhphPayments       BhphPayment[]
  activities         Activity[]
  appointments       Appointment[]
  communications     Communication[]
  vehicles           Vehicle[]
  deals              Deal[]
  documents          Document[]
  documentSignatures DocumentSignature[]
  bhphContracts      BhphContract[]
  pipelineStages     PipelineStage[]
  tasks              Task[]
  tickets            Ticket[]
  leadScores         LeadScore[]
  agentRuns          AgentRun[]
  embeddings         Embedding[]
  syndicationLogs    SyndicationLog[]
  vehicleMedia       VehicleMedia[]
  routingLog         LeadRoutingLog[]
  calendarEvents     CalendarEvent[]
  duplicateLogs      DuplicateDetectionLog[]
  mergeRecords       CustomerMergeRecord[]
  activityLogs       ActivityLog[]
  campaigns          Campaign[]
  enrollments        CampaignEnrollment[]
  subscription       Subscription?
  stripeInvoices     InvoiceStripe[]
  usageRecords       UsageRecord[]
  notifications      Notification[]
  website            DealerWebsite?

  @@index([subdomain])
  @@map("dealers")
}

// ============================================================
// BILLING — STRIPE SUBSCRIPTIONS
// ============================================================

/// Subscription — one Stripe subscription per dealer. Mirrors the
/// canonical state from Stripe so we can serve the dashboard without
/// making a Stripe API call on every page load. Updated on every
/// webhook event and on direct mutations (upgrade / cancel).
model Subscription {
  id                   String             @id @default(cuid())
  dealerId             String             @unique
  dealer               Dealer             @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  stripePriceId        String
  /// Cached plan enum (also driven by the dealer's `plan` column on
  /// onboarding, but kept in sync from webhooks to make dashboard
  /// rendering cheap).
  plan                 SubscriptionPlan
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([dealerId])
  @@index([status])
  @@index([plan])
  @@map("subscriptions")
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

/// InvoiceStripe — one row per Stripe invoice we've seen for the
/// dealer. Backed by the `stripe_invoices` table to avoid clashing
/// with the existing Document.metadata approach for ad-hoc invoicing.
model InvoiceStripe {
  id              String    @id @default(cuid())
  dealerId        String
  dealer          Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  stripeInvoiceId String    @unique
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("usd")
  status          String
  pdfUrl          String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([dealerId])
  @@index([dealerId, createdAt])
  @@index([status])
  @@map("stripe_invoices")
}

/// UsageRecord — metered usage events. One row per "thing consumed"
/// (a lead created, an SMS sent, an email sent, AI tokens spent).
/// Aggregated by the usage-meter service to enforce plan limits.
model UsageRecord {
  id         String   @id @default(cuid())
  dealerId   String
  dealer     Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  /// Free-form metric key. Convention: 'leads' | 'sms_sent' | 'emails_sent' | 'ai_tokens'
  metric     String
  quantity   Int      @default(1)
  recordedAt DateTime @default(now())
  metadata   Json?

  @@index([dealerId, metric, recordedAt])
  @@index([dealerId, recordedAt])
  @@map("usage_records")
}

enum DealerPlan {
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

// ============================================================
// USERS
// ============================================================

/// User — authenticated staff member belonging to a dealer.
model User {
  id           String     @id @default(cuid())
  dealerId     String
  email        String
  name         String
  passwordHash String?
  role         UserRole   @default(SALES)
  phone        String?
  permissions  Json       @default("[]")
  lastLogin    DateTime?
  status       UserStatus @default(ACTIVE)
  invitedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  dealer        Dealer                @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  leads         Lead[]                @relation("AssignedLeads")
  activities    Activity[]
  appointments  Appointment[]
  deals         Deal[]
  notes         Note[]
  routedLeads   LeadRoutingLog[]      @relation("RoutedLeads")
  activityLogs  ActivityLog[]
  mergeActions  CustomerMergeRecord[] @relation("MergeActor")
  notifications Notification[]
  campaigns     Campaign[]              @relation("CampaignOwner")
  enrollments   CampaignEnrollment[]    @relation("EnrollmentActor")
  assignedTasks Task[]
  createdTasks  Task[] @relation("TaskCreator")
  assignedTickets Ticket[]
  createdTickets Ticket[] @relation("TicketCreator")
  ticketResponses TicketResponse[]

  @@unique([dealerId, email])
  @@index([dealerId])
  @@index([email])
  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
  BDC
  FINANCE
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

// ============================================================
// CRM — LEADS
// ============================================================

/// Lead — sales pipeline entry with scoring and assignment.
model Lead {
  id              String     @id @default(cuid())
  dealerId        String
  source          String?
  status          LeadStatus @default(NEW)
  score           Int        @default(0) // 0–100 (legacy, kept in sync with currentScore)
  currentScore    Int        @default(0) // 0–100 — the rules-based score
  classification  String     @default("cold") // 'cold' | 'warm' | 'hot'
  lastScoredAt    DateTime?
  lastContactedAt DateTime?
  unsubscribed    Boolean    @default(false)
  bounced         Boolean    @default(false)
  assignedToId    String?
  customerId      String?
  firstName       String
  lastName        String
  email           String?
  phone           String?
  vehicleInterest Json       @default("[]")
  sourceMeta      Json       @default("{}")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  dealer         Dealer           @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  assignedTo     User?            @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  activities     Activity[]
  appointments   Appointment[]
  communications Communication[]
  deals          Deal[]
  leadScores     LeadScore[]
  routingLog     LeadRoutingLog[]
  enrollments    CampaignEnrollment[]
  tasks          Task[]

  @@index([dealerId])
  @@index([dealerId, status])
  @@index([dealerId, currentScore])
  @@index([dealerId, classification])
  @@index([assignedToId])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  APPOINTMENT
  DEMO
  DEAL
  LOST
}

// ============================================================
// CRM — CUSTOMERS
// ============================================================

/// Customer — buyer / previous customer record.
model Customer {
  id           String      @id @default(cuid())
  dealerId     String
  firstName    String
  lastName     String
  email        String?
  phone        String?
  address      Json?
  dob          DateTime?
  creditTier   CreditTier?
  dlNumber     String?
  dlProvince   String?
  notes        String?
  tags         String[]    @default([])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  // Duplicate detection / merge
  mergedIntoId String?
  deletedAt    DateTime?

  // Relations
  dealer                Dealer                @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  mergedInto            Customer?             @relation("CustomerMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom            Customer[]            @relation("CustomerMerge")
  leads                 Lead[]
  tasks                 Task[]
  deals                 Deal[]
  activities            Activity[]
  appointments          Appointment[]
  communications        Communication[]
  mergeMasterRecords    CustomerMergeRecord[] @relation("MergeMaster")
  mergeDuplicateRecords CustomerMergeRecord[] @relation("MergeDuplicate")
  enrollments           CampaignEnrollment[]

  @@index([dealerId])
  @@index([dealerId, lastName])
  @@index([dealerId, email])
  @@index([dealerId, phone])
  @@index([dealerId, deletedAt])
  @@index([mergedIntoId])
  @@map("customers")
}

enum CreditTier {
  A
  B
  C
  D
  SUBPRIME
}

// ============================================================
// CRM — ACTIVITIES
// ============================================================

/// Activity — timeline of all interactions across CRM entities.
model Activity {
  id         String       @id @default(cuid())
  dealerId   String
  entityType EntityType
  entityId   String
  type       ActivityType
  body       String?
  metadata   Json?
  authorId   String?
  agentName  String?
  createdAt  DateTime     @default(now())

  // Relations
  dealer   Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  author   User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  lead     Lead?     @relation(fields: [entityId], references: [id], map: "fk_activity_lead")
  customer Customer? @relation(fields: [entityId], references: [id], map: "fk_activity_customer")
  deal     Deal?     @relation(fields: [entityId], references: [id], map: "fk_activity_deal")
  vehicle  Vehicle?  @relation(fields: [entityId], references: [id], map: "fk_activity_vehicle")

  @@index([dealerId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activities")
}

enum EntityType {
  LEAD
  CUSTOMER
  DEAL
  VEHICLE
}

enum ActivityType {
  CALL
  EMAIL
  SMS
  NOTE
  APPOINTMENT
  STATUS_CHANGE
  AI_ACTION
}

// ============================================================
// CRM — APPOINTMENTS
// ============================================================

/// Appointment — scheduled events tied to leads or customers.
model Appointment {
  id           String            @id @default(cuid())
  dealerId     String
  leadId       String?
  customerId   String?
  assignedToId String?
  type         AppointmentType
  scheduledAt  DateTime
  durationMin  Int               @default(30)
  status       AppointmentStatus @default(SCHEDULED)
  notes        String?
  createdAt    DateTime          @default(now())

  // Relations
  dealer     Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([dealerId])
  @@index([dealerId, scheduledAt])
  @@index([assignedToId])
  @@map("appointments")
}

enum AppointmentType {
  SALES
  TEST_DRIVE
  SERVICE
  DELIVERY
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ============================================================
// CRM — COMMUNICATIONS
// ============================================================

/// Communication — logged inbound/outbound messages across channels.
model Communication {
  id          String                 @id @default(cuid())
  dealerId    String
  leadId      String?
  customerId  String?
  channel     CommunicationChannel
  direction   CommunicationDirection
  fromAddr    String?
  toAddr      String?
  subject     String?
  body        String?
  status      CommunicationStatus    @default(SENT)
  externalId  String?
  aiGenerated Boolean                @default(false)
  sentAt      DateTime               @default(now())

  // Relations
  dealer   Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([dealerId])
  @@index([leadId])
  @@index([customerId])
  @@map("communications")
}

enum CommunicationChannel {
  SMS
  EMAIL
  WHATSAPP
  VOICE
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CommunicationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

// ============================================================
// INVENTORY — VEHICLES
// ============================================================

/// Vehicle — inventory unit. VIN is unique per dealer (not globally).
model Vehicle {
  id            String           @id @default(cuid())
  dealerId      String
  vin           String
  make          String
  model         String
  year          Int
  trim          String?
  bodyStyle     String?
  mileage       Int?
  exteriorColor String?
  interiorColor String?
  fuelType      String?
  transmission  String?
  drivetrain    String?
  engine        String?
  condition     VehicleCondition @default(USED)
  status        VehicleStatus    @default(AVAILABLE)
  stockNumber   String?
  notes         String?
  acquiredAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  dealer          Dealer           @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  pricing         VehiclePricing?
  media           VehicleMedia[]
  syndicationLogs SyndicationLog[]
  deals           Deal[]
  activities      Activity[]

  @@unique([dealerId, vin])
  @@index([dealerId])
  @@index([dealerId, status])
  @@index([make, model])
  @@map("vehicles")
}

enum VehicleCondition {
  NEW
  USED
  CERTIFIED
}

enum VehicleStatus {
  AVAILABLE
  SOLD
  PENDING
  WHOLESALE
}

// ============================================================
// INVENTORY — PRICING
// ============================================================

/// VehiclePricing — cost, prices, and floor plan info per vehicle.
model VehiclePricing {
  id            String   @id @default(cuid())
  vehicleId     String   @unique
  cost          Float?
  askingPrice   Float?
  internetPrice Float?
  marketValue   Float?
  floorPlan     Float?
  reconCost     Float?
  updatedAt     DateTime @default(now()) @updatedAt

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_pricing")
}

// ============================================================
// INVENTORY — MEDIA
// ============================================================

/// VehicleMedia — photos, videos, 360° spins for vehicles.
model VehicleMedia {
  id         String    @id @default(cuid())
  vehicleId  String
  dealerId   String
  s3Key      String
  cdnUrl     String?
  type       MediaType @default(PHOTO)
  sortOrder  Int       @default(0)
  aiScore    Float?
  isPrimary  Boolean   @default(false)
  uploadedAt DateTime  @default(now())

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dealer  Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([dealerId])
  @@map("vehicle_media")
}

enum MediaType {
  PHOTO
  VIDEO
  SPIN360
}

// ============================================================
// INVENTORY — SYNDICATION
// ============================================================

/// SyndicationLog — sync history with third-party listing platforms.
model SyndicationLog {
  id         String             @id @default(cuid())
  vehicleId  String
  dealerId   String
  channel    SyndicationChannel
  status     String?
  externalId String?
  lastSynced DateTime?
  errorMsg   String?
  createdAt  DateTime           @default(now())

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dealer  Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([dealerId, channel])
  @@map("syndication_logs")
}

enum SyndicationChannel {
  AUTOTRADER
  CARGURUS
  KIJIJI
  FACEBOOK
}

// ============================================================
// DEALS & F&I
// ============================================================

/// Deal — sales transaction tying customer, vehicle, and terms together.
model Deal {
  id           String     @id @default(cuid())
  dealerId     String
  customerId   String
  vehicleId    String?
  leadId       String?
  assignedToId String?
  status       DealStatus @default(WORKING)
  dealType     DealType   @default(RETAIL)
  createdAt    DateTime   @default(now())
  deliveredAt  DateTime?

  // Relations
  dealer       Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  lead         Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo   User?               @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  terms        DealTerms?
  fiProducts   FiProduct[]
  documents    Document[]
  signatures   DocumentSignature[]
  activities   Activity[]
  bhphContract BhphContract?

  @@index([dealerId])
  @@index([dealerId, status])
  @@index([customerId])
  @@map("deals")
}

enum DealStatus {
  WORKING
  PENDING_FINANCE
  APPROVED
  DELIVERED
  UNWOUND
}

enum DealType {
  RETAIL
  LEASE
  BHPH
  WHOLESALE
  CASH
}

// ============================================================
// DEALS — TERMS
// ============================================================

/// DealTerms — financial structure of a deal.
model DealTerms {
  id             String  @id @default(cuid())
  dealId         String  @unique
  salePrice      Float?
  tradeValue     Float?
  tradePayoff    Float?
  downPayment    Float?
  taxAmount      Float?
  feeTotal       Float?
  financedAmount Float?
  rate           Float?
  termMonths     Int?
  paymentAmount  Float?
  lender         String?
  frontGross     Float?
  backGross      Float?

  // Relations
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("deal_terms")
}

// ============================================================
// DEALS — F&I PRODUCTS
// ============================================================

/// FiProduct — optional F&I products attached to a deal.
model FiProduct {
  id           String        @id @default(cuid())
  dealId       String
  productType  FiProductType
  provider     String?
  cost         Float?
  sellingPrice Float?
  termMonths   Int?
  deductible   Float?

  // Relations
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("fi_products")
}

enum FiProductType {
  WARRANTY
  GAP
  CREDIT_INSURANCE
  TIRE_WHEEL
  RUST
}

// ============================================================
// DEALS — DOCUMENTS
// ============================================================

/// Document — signed/unsigned files attached to deals, invoices, or
/// other record types. The `metadata` JSON column is used by the
/// invoice service to persist amount/line items/status without a
/// dedicated Invoice table.
model Document {
  id         String    @id @default(cuid())
  dealId     String?
  dealerId   String
  type       String?
  s3Key      String
  docusignId String?
  signedAt   DateTime?
  signedBy   String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  // Relations
  deal       Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealer     Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  signatures DocumentSignature[]

  @@index([dealerId])
  @@index([dealId])
  @@index([dealerId, type])
  @@map("documents")
}

// ============================================================
// DOCUSIGN — E-SIGNATURE ENVELOPES
// ============================================================

/// DocumentSignature — a DocuSign envelope attached to a deal. The
/// `signers` JSON column is the source of truth for per-recipient
/// status (DocuSign's webhook payload is the live source during
/// signing; we mirror it here for tenant-scoped reads).
///
/// Lifecycle:
///   CREATED → SENT → DELIVERED → COMPLETED
///                    ↘ DECLINED
///                    ↘ VOIDED
///                    ↘ EXPIRED
///
/// `pdfUrl` is populated by the webhook handler once DocuSign
/// emits `envelope-completed` and the combined PDF is downloaded
/// to S3.
model DocumentSignature {
  id             String          @id @default(cuid())
  dealerId       String
  dealId         String?
  documentId     String?
  envelopeId     String          @unique // DocuSign envelope ID
  templateId     String
  status         SignatureStatus @default(CREATED)
  signers        Json            @default("[]")
  documentType   DocumentType
  subject        String?
  emailMessage   String?
  createdById    String?
  completedAt    DateTime?
  declinedAt     DateTime?
  declinedReason String?
  voidedAt       DateTime?
  voidedReason   String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  expiresAt      DateTime?
  pdfUrl         String?
  pdfS3Key       String?
  metadata       Json?           @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  dealer   Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  deal     Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([dealerId, envelopeId])
  @@index([dealerId])
  @@index([dealerId, status])
  @@index([dealerId, documentType])
  @@index([dealerId, createdAt])
  @@index([dealId])
  @@index([documentId])
  @@index([status])
  @@index([completedAt])
  @@map("document_signatures")
}

enum SignatureStatus {
  CREATED
  SENT
  DELIVERED
  COMPLETED
  DECLINED
  VOIDED
  EXPIRED
}

enum DocumentType {
  BILL_OF_SALE
  FI_CONTRACT
  CREDIT_APP
  WARRANTY
  DISCLOSURE
  TRADE_APPRAISAL
  DELIVERY_RECEIPT
  OTHER
}

// ============================================================
// BHPH — CONTRACTS
// ============================================================

/// BhphContract — buy-here-pay-here in-house financing contract.
model BhphContract {
  id            String   @id @default(cuid())
  dealId        String   @unique
  dealerId      String
  principal     Float
  rate          Float
  termMonths    Int
  paymentAmount Float
  paymentDay    Int
  firstPayment  DateTime
  maturityDate  DateTime
  totalPayments Float
  status        String   @default("active")

  // Relations
  deal     Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealer   Dealer        @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  payments BhphPayment[]

  @@index([dealerId])
  @@map("bhph_contracts")
}

// ============================================================
// BHPH — PAYMENTS
// ============================================================

/// BhphPayment — individual payment records for BHPH contracts.
model BhphPayment {
  id               String    @id @default(cuid())
  contractId       String
  dealerId         String
  dueDate          DateTime
  paidDate         DateTime?
  amountDue        Float
  amountPaid       Float?
  principalPortion Float?
  interestPortion  Float?
  balanceAfter     Float?
  method           String?
  status           String    @default("pending")

  // Relations
  contract BhphContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  dealer   Dealer       @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([dealerId])
  @@map("bhph_payments")
}

// ============================================================
// AI & ANALYTICS — LEAD SCORES
// ============================================================

/// LeadScore — historical snapshot of a lead's rules-based score.
/// One row per recompute; the `Lead.currentScore` and `Lead.classification`
/// columns are the latest projection (denormalized for fast list queries).
model LeadScore {
  id             String   @id @default(cuid())
  dealerId       String
  leadId         String
  score          Int // 0–100
  classification String // 'cold' | 'warm' | 'hot'
  signals        Json     @default("{}") // rule → delta map (e.g. { hasEmail: 20, hasPhone: 20 })
  modelVersion   String   @default("rules-v1")
  scoredAt       DateTime @default(now())

  // Relations
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([dealerId])
  @@index([dealerId, leadId, scoredAt])
  @@index([scoredAt])
  @@map("lead_scores")
}

