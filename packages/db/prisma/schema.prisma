// ============================================================
// ACTIVITY LOGS — comprehensive audit trail (DMS Module 10.2)
// ============================================================

/// ActivityLog — exhaustive, append-only audit log of every user action
/// and significant system event. Multi-tenant (scoped by `dealerId`),
/// queryable by action / entity / user / time range, and feeds the
/// anomaly detector. Companion to the lighter `Activity` model which
/// tracks CRM touchpoints only.
model ActivityLog {
  id         String   @id @default(cuid())
  dealerId   String
  userId     String?
  action     String // e.g. 'lead.created', 'customer.updated', 'vehicle.deleted'
  entityType String // 'lead' | 'customer' | 'vehicle' | 'deal' | 'user' | 'invoice' | etc
  entityId   String?
  before     Json? // snapshot of entity before change
  after      Json? // snapshot after change
  diff       Json? // { changed: [{field, before, after}], added: [...], removed: [...] }
  ipAddress  String?
  userAgent  String?
  metadata   Json? // additional context (requestId, batchId, anomaly flags, etc.)
  createdAt  DateTime @default(now())

  // Relations
  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([dealerId])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([dealerId, createdAt])
  @@index([dealerId, action])
  @@map("activity_logs")
}

// ============================================================
// LEAD ROUTING — AI engine logs
// ============================================================

/// LeadRoutingLog — audit trail of every routing decision the AI engine
/// makes. Records strategy, candidates, choice, reason, and timing.
model LeadRoutingLog {
  id             String   @id @default(cuid())
  dealerId       String
  leadId         String
  strategyUsed   String
  candidateReps  Json
  selectedRepId  String?
  reason         String
  responseTimeMs Int
  routedAt       DateTime @default(now())

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  rep    User?  @relation("RoutedLeads", fields: [selectedRepId], references: [id], onDelete: SetNull)

  @@index([dealerId])
  @@index([dealerId, routedAt])
  @@index([leadId])
  @@index([routedAt])
  @@index([selectedRepId])
  @@map("lead_routing_log")
}

// ============================================================
// DUPLICATE DETECTION & MERGE
// ============================================================

/// DuplicateDetectionLog — every pair of records scored by the
/// duplicate detector. Status flow: `pending` → `merged` | `dismissed`.
/// Classification thresholds:
///   - `auto_merge`   (score >= 0.90) — high confidence, prompt to merge
///   - `flag`         (0.65 <= score < 0.90) — show badge, manual review
///   - `not_duplicate` (score < 0.65)   — not stored in this table
model DuplicateDetectionLog {
  id             String    @id @default(cuid())
  dealerId       String
  entityType     String // 'customer' | 'lead'
  entityAId      String
  entityBId      String
  score          Float
  reasons        Json // ['email match', 'phone last-7 match', ...]
  classification String // 'auto_merge' | 'flag' | 'not_duplicate'
  status         String    @default("pending") // pending | merged | dismissed
  mergedAt       DateTime?
  mergedById     String?
  mergeRecordId  String?
  dismissedAt    DateTime?
  dismissedById  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  dealer      Dealer               @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  mergeRecord CustomerMergeRecord? @relation(fields: [mergeRecordId], references: [id], onDelete: SetNull)

  @@unique([dealerId, entityType, entityAId, entityBId])
  @@index([dealerId])
  @@index([dealerId, status])
  @@index([dealerId, classification])
  @@index([entityType, entityAId])
  @@index([entityType, entityBId])
  @@index([createdAt])
  @@map("duplicate_detection_log")
}

/// CustomerMergeRecord — audit record of every customer merge and
/// its unmerge history. Recoverable for 30 days after `mergedAt`.
model CustomerMergeRecord {
  id               String    @id @default(cuid())
  dealerId         String
  masterId         String // the kept customer
  duplicateId      String // the soft-deleted customer
  fieldChoices     Json // { firstName: 'master'|'duplicate', email: ..., ... }
  // Snapshot of pre-merge values so we can unmerge deterministically
  masterBefore     Json?
  duplicateBefore  Json?
  mergedById       String
  mergedAt         DateTime  @default(now())
  unmergedAt       DateTime?
  unmergedById     String?
  recoverable      Boolean   @default(true)
  recoveryDeadline DateTime?
  // Counts of related records that were reassigned
  movedCounts      Json? // { deals: 3, leads: 1, appointments: 5, ... }
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  dealer        Dealer                  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  master        Customer                @relation("MergeMaster", fields: [masterId], references: [id])
  duplicate     Customer                @relation("MergeDuplicate", fields: [duplicateId], references: [id])
  mergedBy      User                    @relation("MergeActor", fields: [mergedById], references: [id])
  duplicateLogs DuplicateDetectionLog[]

  @@index([dealerId])
  @@index([dealerId, mergedAt])
  @@index([masterId])
  @@index([duplicateId])
  @@index([mergedById])
  @@map("customer_merge_records")
}

// ============================================================
// NOTIFICATIONS — per-user inbox, pushed via WebSocket
// ============================================================

/// Notification — per-user inbox entry. Persisted so a user can
/// re-read the bell panel after a refresh; pushed live via the
/// WebSocket layer when first created. Multi-tenant scoped through
/// `dealerId`; the FK to User is `onDelete: Cascade` so a user-delete
/// purges their inbox.
model Notification {
  id         String              @id @default(cuid())
  dealerId   String
  userId     String
  type       NotificationType
  title      String
  body       String
  entityType NotificationEntity? // 'lead' | 'deal' | 'customer' | 'vehicle' | 'appointment' | 'test_drive' | 'system'
  entityId   String?
  metadata   Json?               @default("{}")
  isRead     Boolean             @default(false)
  readAt     DateTime?
  createdAt  DateTime            @default(now())

  // Relations
  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Hot path: bell badge for the current user (unread count).
  @@index([userId, isRead])
  // List-by-time for the inbox panel.
  @@index([userId, createdAt])
  // Tenant audits + cross-tenant guards.
  @@index([dealerId])
  @@index([dealerId, createdAt])
  // Filter by type for the "by source" tab in the panel.
  @@index([userId, type])
  @@map("notifications")
}

/// NotificationType — canonical verb for the notification. Mirrors
/// the WebSocket `notification` event's `type` field so clients can
/// route on it directly.
enum NotificationType {
  LEAD_ASSIGNED
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  CUSTOMER_CREATED
  DEAL_STAGE_CHANGED
  DEAL_DELIVERED
  VEHICLE_SOLD
  VEHICLE_PRICE_CHANGED
  TEST_DRIVE_SCHEDULED
  TEST_DRIVE_COMPLETED
  APPOINTMENT_REMINDER
  SYSTEM
}

enum NotificationEntity {
  LEAD
  CUSTOMER
  DEAL
  VEHICLE
  APPOINTMENT
  TEST_DRIVE
  USER
  SYSTEM
}

// ============================================================
// PUBLIC DEALER WEBSITE
// ============================================================

/// DealerWebsite — per-dealer white-label marketing site served at
/// `{subdomain}.dealeros.com` (or a CNAME'd custom domain). One row
/// per dealer, optional until they publish.
///
/// `themeConfig` controls the visual layer (logo, brand colors, hero
/// copy, footer links, font family). `seoConfig` controls meta tags,
/// OpenGraph image, and analytics. Both are JSON so we can extend
/// the schema without Prisma migrations.
model DealerWebsite {
  id        String @id @default(cuid())
  dealerId  String @unique
  subdomain String @unique

  // Display / branding
  themeConfig Json @default("{}")
  // {
  //   logo: string | null,
  //   primaryColor: string,   // hex
  //   accentColor: string,    // hex
  //   heroImage: string | null,
  //   heroTitle: string,
  //   heroSubtitle: string,
  //   heroCtaText: string,
  //   heroCtaHref: string,
  //   aboutText: string,
  //   footerLinks: Array<{ label: string, href: string }>,
  //   fontFamily: string,
  //   address: { line1, line2?, city, region, postal, country },
  //   phone: string,
  //   email: string,
  //   hours: Array<{ day: string, open: string, close: string }>
  // }

  // SEO / analytics
  seoConfig Json @default("{}")
  // {
  //   title: string,
  //   description: string,
  //   keywords: string[],
  //   ogImage: string | null,
  //   googleAnalyticsId: string | null,
  //   facebookPixelId: string | null,
  //   hreflang: Array<{ lang: string, url: string }>
  // }

  // Optional custom domain (CNAME) — e.g. www.mountainviewauto.com
  customDomain String? @unique

  // Publishing + telemetry
  isPublished Boolean @default(false)
  viewCount   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([subdomain])
  @@index([isPublished])
  @@index([customDomain])
  @@map("dealer_websites")
}

// ============================================================
// MARKETING CAMPAIGNS — drip sequences / lead nurturing
// (AdaptUs DMS Module 7 — Marketing Automation)
// ============================================================

/// Campaign — a multi-step marketing automation that runs a
/// pre-defined sequence of channel-based steps (email, SMS, wait,
/// branch) against an enrolled audience. Lifecycle:
///
///   DRAFT → ACTIVE → PAUSED → ACTIVE → ARCHIVED
///
/// Multi-tenant: every campaign is scoped by `dealerId`. The owner
/// (`createdById`) is recorded for audit + RBAC; it does NOT have to
/// match the executing user (delegated scheduling is allowed for
/// manager+ roles).
///
/// `triggerType` and `triggerConfig` define the "what enrolls a
/// record" rule. The CampaignTriggerService listens to BullMQ events
/// and evaluates these rules per dealer in real time.
model Campaign {
  id          String         @id @default(cuid())
  dealerId    String
  createdById String
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  // What fires enrollment. Pair with `triggerConfig` JSON.
  triggerType CampaignTriggerType
  // Free-form rule definition (structure depends on triggerType):
  //   lead_created  → {} (any new lead)
  //   status_change → { from: "NEW", to: "CONTACTED" }
  //   no_activity   → { days: 14 }
  //   deal_stage    → { stage: "DELIVERED" }
  //   appointment   → { type: "TEST_DRIVE", status: "COMPLETED" }
  //   score_change  → { classification: "hot" }
  //   birthday      → { daysBefore: 7 }
  //   vehicle_match → { make: "Toyota", model: "RAV4" }
  //   manual        → {} (operator only)
  //   api           → {} (external system)
  triggerConfig Json          @default("{}")
  // Audience filter — same shape as the Lead list filter. Applied at
  // enrollment time AND for "backfill" runs of a manual campaign.
  audience Json              @default("{}")
  // Stats — denormalised, refreshed on every step completion.
  enrolledCount  Int @default(0)
  activeCount    Int @default(0)
  completedCount Int @default(0)
  exitedCount    Int @default(0)
  failedCount    Int @default(0)
  // When the campaign was last activated (for cooldown logic).
  activatedAt DateTime?
  pausedAt    DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  dealer      Dealer                @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  createdBy   User                  @relation("CampaignOwner", fields: [createdById], references: [id], onDelete: Cascade)
  steps       CampaignStep[]
  enrollments CampaignEnrollment[]

  // Tenant scoping + active-campaign lookups.
  @@index([dealerId])
  @@index([dealerId, status])
  @@index([dealerId, triggerType])
  @@index([status, activatedAt])
  @@map("campaigns")
}

/// CampaignStatus — workflow state of a campaign.
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/// CampaignTriggerType — which domain event auto-enrolls records.
enum CampaignTriggerType {
  LEAD_CREATED
  LEAD_UPDATED
  STATUS_CHANGE
  NO_ACTIVITY
  DEAL_STAGE
  APPOINTMENT
  SCORE_CHANGE
  BIRTHDAY
  VEHICLE_MATCH
  MANUAL
  API
}

/// CampaignStep — a single ordered step inside a campaign.
///
/// `stepType` decides how the step processor behaves:
///   EMAIL       → send a templated email (SendGrid)
///   SMS         → send a templated SMS (Twilio)
///   WAIT        → pause the enrollment for `waitHours` hours
///   BRANCH      → split on a field condition (one of `branchConfig.thenStep` / `branchConfig.elseStep`)
///   WEBHOOK     → POST to an external URL with the enrollment payload
///   TASK        → create an internal "follow up" task assigned to a rep
///   EXIT        → gracefully end the enrollment
///
/// `order` is the zero-based index inside the campaign. For the
/// `BRANCH` step, `branchConfig` carries the predicate; for
/// `WAIT`, `waitHours` is the duration. For EMAIL/SMS, `template` is
/// the subject+body (with `{{first_name}}` placeholders) and
/// `fromAddress` is the sender override.
model CampaignStep {
  id          String         @id @default(cuid())
  campaignId  String
  // Order within the campaign, 0-based.
  order       Int
  // Display name for the step in the editor UI.
  name        String
  stepType    CampaignStepType
  // The body / subject for EMAIL, message for SMS, etc.
  // Supports `{{first_name}}`, `{{last_name}}`, `{{email}}`,
  // `{{phone}}`, `{{dealership_name}}`, `{{agent_name}}` etc.
  template    String?
  subject     String? // For EMAIL — separate from body
  // For WAIT steps.
  waitHours   Int?           @default(0)
  // For BRANCH steps: { field: "currentScore", op: ">=", value: 60, thenStep: 3, elseStep: 5 }
  branchConfig Json?         @default("{}")
  // For WEBHOOK steps.
  webhookUrl  String?
  webhookMethod String?      @default("POST")
  // For TASK steps: which user role / specific user to assign to.
  taskAssignToId String?
  // Override sender for EMAIL.
  fromAddress String?
  // Skip on weekends? (for B2B-style steps).
  skipWeekends Boolean       @default(false)
  // Free-form metadata (e.g. A/B variant id, link tracking params).
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, order])
  @@index([campaignId])
  @@map("campaign_steps")
}

/// CampaignStepType — kinds of steps a campaign can run.
enum CampaignStepType {
  EMAIL
  SMS
  WAIT
  BRANCH
  WEBHOOK
  TASK
  EXIT
}

/// CampaignEnrollment — one record (lead or customer) enrolled in a
/// campaign. The state machine lives in `status`; the runtime cursor
/// is `currentStepOrder`.
///
/// Lifecycle (most common path):
///   PENDING  →  ACTIVE  →  COMPLETED
///                     └──> EXITED       (user unsubscribed / branch off-path)
///                     └──> FAILED       (channel error, retried < maxAttempts)
///
/// `nextRunAt` is the wall-clock time the next WAIT/EMAIL/SMS step
/// becomes eligible. The step-processor service polls BullMQ delayed
/// jobs on this column.
model CampaignEnrollment {
  id           String                 @id @default(cuid())
  dealerId     String
  campaignId   String
  // Subject of the enrollment (the lead or customer being nurtured).
  leadId       String?
  customerId   String?
  // Audit: who/what triggered the enrollment.
  enrolledById String?
  triggerType  CampaignTriggerType
  triggerPayload Json                @default("{}")
  // Runtime state.
  status       CampaignEnrollmentStatus @default(PENDING)
  currentStepOrder Int                @default(0)
  nextRunAt    DateTime?
  // Counters (denormalised from CampaignStepExecution rows).
  stepsExecuted Int                   @default(0)
  stepsFailed   Int                   @default(0)
  emailsSent    Int                   @default(0)
  smsSent       Int                   @default(0)
  // Idempotency: external provider message ids (per step).
  lastExternalIds Json                @default("{}")
  // Error bookkeeping (most recent failure).
  lastError    String?
  attemptCount Int                    @default(0)
  // Lifecycle timestamps.
  enrolledAt   DateTime               @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  exitedAt     DateTime?
  failedAt     DateTime?
  updatedAt    DateTime               @updatedAt

  // Relations
  dealer     Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  campaign   Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead       Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer   Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  enrolledBy User?               @relation("EnrollmentActor", fields: [enrolledById], references: [id], onDelete: SetNull)
  executions CampaignStepExecution[]

  // Idempotency: never enroll the same (campaign, lead/customer) twice.
  // The partial-unique below is modelled by separate indexes since
  // PostgreSQL treats NULLs as distinct in unique constraints.
  @@index([dealerId])
  @@index([dealerId, status])
  @@index([campaignId, status])
  @@index([leadId])
  @@index([customerId])
  @@index([status, nextRunAt])
  @@index([dealerId, campaignId, leadId])
  @@index([dealerId, campaignId, customerId])
  @@map("campaign_enrollments")
}

/// CampaignEnrollmentStatus — state of a single enrollment.
enum CampaignEnrollmentStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  EXITED
  FAILED
}

/// CampaignStepExecution — append-only log of every step the processor
/// ran for an enrollment. Used for analytics, debugging, and replay.
model CampaignStepExecution {
  id           String                 @id @default(cuid())
  dealerId     String
  enrollmentId String
  stepId       String
  stepOrder    Int
  stepType     CampaignStepType
  status       CampaignStepExecutionStatus @default(PENDING)
  // Provider response (SendGrid / Twilio messageId, HTTP status, etc.).
  externalId   String?
  errorMessage String?
  attempts     Int                    @default(0)
  durationMs   Int?
  // Snapshot of the rendered body that was actually sent (after
  // template substitution). Useful for compliance + debugging.
  renderedBody String?
  renderedSubject String?
  startedAt    DateTime               @default(now())
  completedAt  DateTime?

  // Relations
  enrollment CampaignEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([dealerId, status])
  @@index([dealerId, startedAt])
  @@index([stepId])
  @@map("campaign_step_executions")
}

/// CampaignStepExecutionStatus — outcome of one step run.
enum CampaignStepExecutionStatus {
  PENDING
  RUNNING
  SENT
  DELIVERED
  SKIPPED
  FAILED
}

// ============================================================
// CALENDAR — Events / Appointments (general-purpose)
// ============================================================

/// CalendarEvent — general-purpose calendar events for the dealer team.
/// Distinct from `Appointment` which is lead/customer scoped; these events
/// can represent team meetings, company holidays, service bay slots, or
/// any ad-hoc time block.
model CalendarEvent {
  id          String             @id @default(cuid())
  dealerId    String
  userId      String?
  title       String
  description String?
  type        CalendarEventType
  start       DateTime
  end         DateTime
  allDay      Boolean            @default(false)
  /// Optional link to a CRM entity (lead, customer, vehicle, deal, appointment).
  entityType  String?
  entityId    String?
  color       String             @default("#6366f1")
  location    String?
  reminderAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Relations
  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId])
  @@index([dealerId, start, end])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("calendar_events")
}

enum CalendarEventType {
  MEETING
  SHOWING
  SERVICE
  TEAM_EVENT
  COMPANY_HOLIDAY
  TRAINING
  REMINDER
  BLOCKED_TIME
}

