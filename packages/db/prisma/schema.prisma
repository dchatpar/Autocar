/// Embedding — vector embeddings for semantic search (pgvector).
/// NOTE: `vector(1536)` is provided as Unsupported() for Prisma Client generation.
/// The actual extension must be enabled in PostgreSQL via: CREATE EXTENSION IF NOT EXISTS vector;
/// For production use, consider @prisma/adapter-pgvector or raw SQL for vector operations.
model Embedding {
  id         String                      @id @default(cuid())
  dealerId   String
  entityType String
  entityId   String
  vector     Unsupported("vector(1536)")
  model      String?
  createdAt  DateTime                    @default(now())

  // Relations
